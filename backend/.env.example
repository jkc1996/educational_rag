# Required
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model allowlist exposed to the frontend model selector.
OPENAI_ALLOWED_CHAT_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.4-nano

# Balanced default policy:
# - default/final model for QA and final question-paper synthesis
# - summary model for chunk/document summaries and blueprints
# - utility model for cheap helper work
OPENAI_DEFAULT_CHAT_MODEL=gpt-5.4
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
OPENAI_UTILITY_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Storage and API behavior
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CHUNK_SIZE=1800
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5
MAX_SUMMARY_CHUNKS_PER_DOCUMENT=18
MAX_QUESTIONS_PER_PAPER=50
MAX_RAGAS_QUESTIONS=25
DAILY_SOFT_BUDGET_USD=5.0
